# Copy this file to create .env
# cp .env.example .env

# Keepa
KEEPA_API_KEY=

# Amazon PA-API
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.co.jp
PAAPI_REGION=us-west-2

# Claude API
ANTHROPIC_API_KEY=

# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bluesky
BSKY_IDENTIFIER=vueprix.bsky.social
BSKY_PASSWORD=

# Notion (投稿文集約 DB)
# vueprix integration を「vueprix 投稿文」DB に connect、$NOTION_API_KEY を流用
NOTION_API_KEY=
NOTION_VUEPRIX_DATA_SOURCE_ID=

# Operation
DRY_RUN=true
LOG_LEVEL=info
