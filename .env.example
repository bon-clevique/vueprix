# Copy this file to create .env
# cp .env.example .env

# Keepa
KEEPA_API_KEY=

# Amazon (アフィリエイト URL 組立て)
AMAZON_PARTNER_TAG=

# Claude API
ANTHROPIC_API_KEY=

# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bluesky
# 推奨: BLUESKY_* prefix を使う (PR: post-interval)。
# 互換性のため BSKY_IDENTIFIER / BSKY_PASSWORD も fallback で読まれる (空文字も「未設定」扱い)。
BLUESKY_IDENTIFIER=vueprix.bsky.social
BLUESKY_APP_PASSWORD=
# interval gate (5〜15 分の連投抑制) で getAuthorFeed の actor に使う。
# 未設定なら handle (BLUESKY_IDENTIFIER) で代替するため optional。
# `bsky.app/profile/<handle>` ページの "DID" や resolveHandle API で取得できる。
BLUESKY_DID=
# 旧名 (移行期 fallback、未使用なら空のままで OK)
BSKY_IDENTIFIER=
BSKY_PASSWORD=

# Notion (投稿文集約 DB + トーンガイドライン DB)
# vueprix integration を両 DB に connect、$NOTION_API_KEY を流用
NOTION_API_KEY=
NOTION_VUEPRIX_DATA_SOURCE_ID=
# Optional — トーンガイドライン DB の data_source_id (未設定なら guidelines は空で動作)
NOTION_VUEPRIX_GUIDELINES_DATA_SOURCE_ID=
# Optional — Run logs DB (cron 実行ログ集約)。未設定なら appendRunLog は warn ログのみで no-op
NOTION_VUEPRIX_RUN_LOG_DATA_SOURCE_ID=
# 固定ASIN DB (FIXED_ASINS の投稿文紹介部分を保持)。未設定なら固定ASIN 即投稿は no-op
NOTION_FIXED_ASIN_DATA_SOURCE_ID=
# Optional — ブラックリスト DB (恒久ブロック ASIN)。未設定なら queryBlacklistAsins は warn + 空 Set で no-op
# (既存 blocklist.md / cooldown 経路は通常通り動作)
NOTION_VUEPRIX_BLACKLIST_DATA_SOURCE_ID=

# Operation
LOG_LEVEL=info
